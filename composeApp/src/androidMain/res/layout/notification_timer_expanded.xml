<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded view, following Requirements/DesignRequirements/tracky_notification.png: project,
  task, subtask, then the clock and the Pause pill on one baseline.

  The design's top row is the project title. Android 12+ always draws its own header - app icon,
  "Tracky", timestamp - above custom content, so the project title reads as the first line of ours
  rather than replacing that header. It cannot be replaced.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/timer_project"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/timer_notification_text_primary"
        tools:text="Tracky App Redesign" />

    <TextView
        android:id="@+id/timer_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/timer_notification_text_primary"
        tools:text="Token refresh" />

    <TextView
        android:id="@+id/timer_subtask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textColor="@color/timer_notification_text_secondary"
        tools:text="Auth endpoints" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Running and paused clocks, one at a time; see notification_timer_collapsed. -->
        <Chronometer
            android:id="@+id/timer_chronometer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_mono"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="2:16:09" />

        <TextView
            android:id="@+id/timer_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_mono"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="2:16:09" />

        <LinearLayout
            android:id="@+id/timer_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="28dp"
            android:background="@drawable/bg_timer_pill">

            <ImageView
                android:id="@+id/timer_button_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:src="@drawable/ic_pause" />

            <TextView
                android:id="@+id/timer_button_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Pause" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
