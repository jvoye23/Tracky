# Line endings for files that break or churn when git rewrites them.
# Shell scripts and gradlew need LF, or the shebang reads `/bin/sh\r`.
gradlew                             text eol=lf
*.sh                                text eol=lf
*.py                                text eol=lf
detekt.yml                          text eol=lf
.editorconfig                       text eol=lf
# cmd.exe is sensitive to line endings inside multi-line constructs.
*.bat                               text eol=crlf
*.cmd                               text eol=crlf
